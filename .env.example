# KinBeat settings for the API and the website, in one file. Copy to .env at the repository root.
# Every line below is read by the code. Only NEXT_PUBLIC_ values ever reach the browser.

# ---- API (api/) ----
# Without MODEL_API_KEY or MODEL_API_BASE_URL the judge runs in mock mode (a keyword rule, not Muse) and nothing is sent.

# Muse model
MODEL_API_KEY=
# The address of your own model server, for example https://<your-app>.modal.direct/v1. There is no default.
MODEL_API_BASE_URL=
MODEL_API_MODEL=muse-spark-1.3
# Prices in US dollars per one million tokens, from your provider's price page. They turn the token counts of each scan
# into a cost in the admin logs. Leave empty to record tokens without a cost. MODEL_PRICE_CACHED is for input the provider had cached.
MODEL_PRICE_INPUT=
MODEL_PRICE_CACHED=
MODEL_PRICE_OUTPUT=
# The month's model budget in US dollars. With the prices above set, model calls stop at 95% of it until the next month;
# scans then show rule results without AI verdicts. Leave empty for no limit.
MODEL_MONTH_LIMIT_USD=
# Tracing (optional). With all three set, each request that calls the model sends one trace to Langfuse: timings, status,
# model name and token counts. No prompt, answer, file name or finding text is ever sent. Leave empty to send nothing.
# LANGFUSE_BASE_URL is the region's address, for example https://cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set to mock to force the keyword judge even when a key is set.
MUSE_MODE=
# Set to off to stop widening the slice from 400 to 800 characters.
MODEL_WIDEN=
# Ask Muse for steadier answers. Set to off to stop sending temperature 0.
MUSE_TEMPERATURE=on

# Speed and spending. 0 means no limit.
# Model calls in flight across all visitors.
MUSE_MAX_CONCURRENT=12
# Turn these on before the app is public. Counted per UTC day, in memory.
MUSE_DAILY_CALLS=0
MUSE_DAILY_CALLS_PER_VISITOR=0
# Ask AI (the chat box). Calls per UTC day, in memory; 0 is off. Defaults 500 and 50.
ASK_DAILY_CALLS=500
ASK_DAILY_CALLS_PER_VISITOR=50
# Ask AI model time per UTC day, in seconds (the AI server bills by the second; 900 s is about 1 dollar on an H100).
# A plan lists days: a day takes the latest entry on or before it; unused time rolls to the next day, up to one day's worth.
# Launch plan: no limit on 2026-11-04, 5 dollars on 2026-11-05, 15 dollars a day from 2026-11-06. Without a plan, ASK_BUDGET_SECONDS applies every day (default 13500, about 15 dollars; 0 is off).
ASK_BUDGET_PLAN=2026-01-01:0,2026-11-05:4500,2026-11-06:13500
# At most this many findings in one model call. Default 100.
# MUSE_BATCH_ROWS=100
# How many pictures one scan may send to the model. Default 30.
# MUSE_MAX_PICTURES=30

# Scan rate limit per visitor. Defaults: 30 scans per 600 seconds.
SCAN_RATE_LIMIT=
SCAN_RATE_WINDOW_SECONDS=
# Tighter limit for GitHub scans that carry a token, so the page cannot test stolen tokens. Defaults: 5 per 600 seconds.
# TOKEN_SCAN_RATE_LIMIT=5
# TOKEN_SCAN_RATE_WINDOW_SECONDS=600
# One overall time limit for a file scan. After it the scan stops and the visitor is told. Default 90.
# SCAN_DEADLINE_SECONDS=90

# Where the API listens. Defaults: 127.0.0.1 and 4100. Keep it on localhost behind the web app.
# HOST=127.0.0.1
# PORT=4100
# How many proxies in front of the web app add the visitor's address (X-Forwarded-For): 0 to 5. Default 1.
# The live site needs one, such as the host's own proxy, nginx or a CDN. Set 2 for a CDN plus a load balancer.
# With none (local development) a visitor can fake the address, so the per-visitor limits can be dodged.
TRUST_PROXY=

# Storage. Without DATABASE_URL, results live in memory and are lost on restart.
DATABASE_URL=
# Owner connection used once to run the SQL migrations.
MIGRATE_DATABASE_URL=
# Fixed key for hashing found secrets. Required when DATABASE_URL is set.
KINSO_HMAC_KEY=

# Sign-in for the logs page
# Admin emails without a database, for tests and quick local runs. Comma separated.
ADMIN_EMAILS=
# Public address of the web app, used in the sign-in link. Default https://localhost:3001.
WEB_PUBLIC_URL=https://localhost:3001
# Host of the admin pages (/logs and /login). Empty in development. For live: admin.kinbeat.com, with WEB_PUBLIC_URL=https://admin.kinbeat.com.
# The main site sends /logs and /login there, and that host shows nothing else. Needs a DNS record for the host on the same web app.
ADMIN_HOST=
# Public name of the live site, for example kinbeat.com. Any other name reaching the web app redirects there. Empty in development.
MAIN_HOST=
# Sign-in link requests per email and visitor. Default 5.
LOGIN_RATE_LIMIT=
# Set to 1 to send the session cookie over HTTPS only. Always on in production.
COOKIE_SECURE=

# Sign-in link email. Brevo when BREVO_API_KEY is set, else Zoho ZeptoMail. Without either, the link is only printed to the API log.
BREVO_API_KEY=
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_ENDPOINT=https://api.zeptomail.eu/v1.1/email
# MAIL_FROM_ADDRESS=noreply@kinbeat.com
# MAIL_FROM_NAME=KinBeat

# Only for the optional Postgres tests. Without them those tests are skipped.
# TEST_DATABASE_URL=
# TEST_APP_DATABASE_URL=

# ---- Website (web/). All optional in development. ----
# Where the web app sends /api calls. Default http://127.0.0.1:4100.
API_URL=
# Public address of the site, used in page links. Default https://localhost:3001. For live: https://kinbeat.com
NEXT_PUBLIC_SITE_URL=
# Google Drive tab. Public browser values from Google Cloud: OAuth web client ID, API key (limited to the Picker API), project number.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Slack tab. From the Slack app's Basic Information page. Without them the Slack tab shows only the Connect button, which fails.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Must match the app's Redirect URL exactly, and use https. Default https://localhost:3001/api/slack/callback.
# Locally the web app runs on https: npm run dev makes a local certificate in web/certificates the first time.
# SLACK_REDIRECT_URL=
# How long a Slack connection lasts, in minutes. Default 10.
# SLACK_SESSION_MINUTES=10
# Only for scripts/slack-seed.ts, which fills a test workspace with made-up chat.
# SLACK_SEED_BOT_TOKEN=
# Where each contact form message is mailed (optional). Needs the mail setup above.
CONTACT_ALERT_TO=
