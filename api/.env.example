# KinBeat API settings. Copy to .env. Every line below is read by the code.
# Without MODEL_API_KEY the judge runs in mock mode (a keyword rule, not Muse).

# Muse model
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
# Set to mock to force the keyword judge even when a key is set.
MUSE_MODE=
# Set to off to stop widening the slice from 400 to 800 characters.
MODEL_WIDEN=
# Ask Muse for steadier answers. Set to off to stop sending temperature 0.
MUSE_TEMPERATURE=on

# Speed and spending. 0 means no limit.
# Findings judged at the same time inside one scan.
SCAN_JUDGE_CONCURRENCY=6
# Model calls in flight across all visitors.
MUSE_MAX_CONCURRENT=12
# Turn these on before the app is public. Counted per UTC day, in memory.
MUSE_DAILY_CALLS=0
MUSE_DAILY_CALLS_PER_VISITOR=0

# Scan rate limit per visitor. Defaults: 30 scans per 600 seconds.
SCAN_RATE_LIMIT=
SCAN_RATE_WINDOW_SECONDS=
# One overall time limit for a file scan. After it the scan stops and the visitor is told. Default 90.
# SCAN_DEADLINE_SECONDS=90

# Where the API listens. Defaults: 127.0.0.1 and 4100. Keep it on localhost behind the web app.
# HOST=127.0.0.1
# PORT=4100
# How many proxies in front of the web app add the visitor's address (X-Forwarded-For): 0 to 5. Default 1.
# The live site needs one, such as the host's own proxy, nginx or a CDN. Set 2 for a CDN plus a load balancer.
# With none (local development) a visitor can fake the address, so the per-visitor limits can be dodged.
TRUST_PROXY=

# Storage. Without DATABASE_URL, results live in memory and are lost on restart.
DATABASE_URL=
# Owner connection used once to run the SQL migrations.
MIGRATE_DATABASE_URL=
# Fixed key for hashing found secrets. Required when DATABASE_URL is set.
KINSO_HMAC_KEY=

# Sign-in for the logs page
# Admin emails without a database, for tests and quick local runs. Comma separated.
ADMIN_EMAILS=
# Public address of the web app, used in the sign-in link. Default http://localhost:3001.
WEB_PUBLIC_URL=http://localhost:3001
# Sign-in link requests per email and visitor. Default 5.
LOGIN_RATE_LIMIT=
# Set to 1 to send the session cookie over HTTPS only. Always on in production.
COOKIE_SECURE=

# Sign-in link email (Zoho ZeptoMail). Without a token the link is only printed to the API log.
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_ENDPOINT=https://api.zeptomail.eu/v1.1/email
# MAIL_FROM_ADDRESS=noreply@kinbeat.com
# MAIL_FROM_NAME=KinBeat

# Only for the optional Postgres tests. Without them those tests are skipped.
# TEST_DATABASE_URL=
# TEST_APP_DATABASE_URL=
